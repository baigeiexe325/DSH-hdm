{
  "name": "dsh-hdm",
  "version": "0.2.8",
  "description": "HDM — Human-like Declarative Memory for DeepSeek Harness: file-based long-term memory with sequential snapshots, keyness retrieval, diary, IAM, character profiles, immortal memories, session-pinned continuation and idle-conversation auto-organizing.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "agent-memory",
    "declarative-memory"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "prompts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baigeiexe325/DSH-hdm.git"
  },
  "homepage": "https://github.com/baigeiexe325/DSH-hdm#readme",
  "bugs": {
    "url": "https://github.com/baigeiexe325/DSH-hdm/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
